# ==========================================
# MediFlow - Git Ignore
# ==========================================

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Entornos virtuales de Python
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log

# Archivos temporales
*.tmp
*.temp

# Claves privadas / certificados
*.pem
*.key
