# LLM - Gemini
GEMINI_CLASSIFIER_API_KEY=
GEMINI_EXTRACTOR_API_KEY=
GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite

# MF-19 | Fallback tecnico -- proveedor SECUNDARIO (Groq / qwen3.8-27b),
# propuesto por el equipo. Gemini sigue siendo el modelo PRINCIPAL en los
# dos agentes, sin cambios; Groq solo se usa si Gemini falla tecnicamente
# (timeout/429/5xx) y agota sus reintentos.
#
# Mientras GROQ_API_KEY quede vacia, el fallback simplemente NO se activa
# y todo sigue funcionando igual que antes de MF-19 (reintentos +
# degradacion controlada). Se genera gratis, sin tarjeta, en
# https://console.groq.com/keys -- limites del plan gratuito para
# qwen/qwen3.8-27b: 30 req/min, 1.000 req/dia, 8.000 tokens/min,
# 200.000 tokens/dia (ver docs/mf-19-fallback-tecnico.md).
GROQ_API_KEY=
GROQ_CLASSIFIER_MODEL_FALLBACK=qwen/qwen3.8-27b
GROQ_EXTRACTOR_MODEL_FALLBACK=qwen/qwen3.8-27b

# OCI Object Storage
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_REGION=
OCI_COMPARTMENT_ID=

# OCI - Autenticacion
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
GEMINI_API_KEY=